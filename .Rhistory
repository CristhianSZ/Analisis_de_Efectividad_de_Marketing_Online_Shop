datos <- read.table("base_ciudad_rioja.txt",
sep = "\t",
header = TRUE,
na.strings = c("NA", ""))
dim(datos)          # filas x columnas
nrow(datos)         # solo filas
ncol(datos)
# ¿Cómo se llaman las variables?
names(datos)
# Vistazo rápido a las primeras filas
head(datos)
head(datos, 10)     # EL ", 10" NOS PERMITE MIRAR LAS primeras 10 filas
# Estructura interna: tipo de cada variable
str(datos)
# ¿Qué vemos aquí?
#   int / num  → variables cuantitativas (números)
#   chr        → variables cualitativas (texto, categorías)
# Resumen inicial automático
summary(datos)
colSums(is.na(datos))
# La media es la suma de todos los valores dividida por la cantidad de casos.
# Es la medida más conocida, pero también la más sensible a valores extremos.
mean(datos$edad,                     na.rm = TRUE)
mean(datos$ingreso_mensual,          na.rm = TRUE)
mean(datos$gasto_alquiler,           na.rm = TRUE)
mean(datos$gasto_gasolina,           na.rm = TRUE)
mean(datos$gasto_transporte_publico, na.rm = TRUE)
mean(datos$cantidad_hijos,           na.rm = TRUE)
# --- Género ---
table(datos$genero)
prop.table(table(datos$genero))                         # proporciones
round(prop.table(table(datos$genero)) * 100, 1)
table(datos$genero)
prop.table(table(datos$genero))                         # proporciones
round(prop.table(table(datos$genero)) * 100, 1)         # en porcentaje
round(prop.table(table(datos$educacion)) * 100, 1)
table(datos$genero, datos$educacion)
hist(datos$edad)
hist(datos$edad,
main  = "Distribución de Edad",
xlab  = "Edad (años)",
ylab  = "Frecuencia",
col   = "steelblue",
border = "white")
abline(v = mean(datos$edad,   na.rm = TRUE), col = "red",    lwd = 2, lty = 1)
abline(v = median(datos$edad, na.rm = TRUE), col = "orange", lwd = 2, lty = 2)
legend("topright", legend = c("Media", "Mediana"),
legend("topright", legend = c("Media", "Mediana"),
col = c("red", "orange"), lwd = 2, lty = c(1, 2))
